<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dcs_ai_conversation_view_list" model="ir.ui.view">
        <field name="name">dcs.ai.conversation.list</field>
        <field name="model">dcs.ai.conversation</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="last_message_date"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="message_count"/>
                <field name="action_count"/>
                <field name="input_tokens" optional="hide"/>
                <field name="output_tokens" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="dcs_ai_conversation_view_form" model="ir.ui.view">
        <field name="name">dcs.ai.conversation.form</field>
        <field name="model">dcs.ai.conversation</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <widget name="web_ribbon" title="Cleared" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="last_message_date"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="1">
                                <list decoration-muted="role == 'tool'" decoration-danger="is_error">
                                    <field name="create_date" string="Time"/>
                                    <field name="role"/>
                                    <field name="input_mode" optional="show"/>
                                    <field name="tool_name" optional="show"/>
                                    <field name="content"/>
                                    <field name="is_error" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operations" name="operations">
                            <field name="action_ids" readonly="1">
                                <list decoration-success="state == 'done'" decoration-danger="state == 'failed'"
                                      decoration-warning="state == 'pending'" decoration-muted="state in ('cancelled', 'expired')">
                                    <field name="create_date" string="Time"/>
                                    <field name="operation"/>
                                    <field name="summary"/>
                                    <field name="model_name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dcs_ai_conversation_view_search" model="ir.ui.view">
        <field name="name">dcs.ai.conversation.search</field>
        <field name="model">dcs.ai.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="mine" string="My conversations" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Cleared" domain="[('active', '=', False)]"/>
                <filter name="all" string="Active and cleared" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcs_ai_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">dcs.ai.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_all': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversations yet</p>
            <p>Open the assistant from the top bar or the floating button and ask a question.</p>
        </field>
    </record>

    <record id="action_dcs_ai_assistant" model="ir.actions.client">
        <field name="name">AI Assistant</field>
        <field name="tag">dcs_ai_voice_assistant.assistant</field>
    </record>
</odoo>
