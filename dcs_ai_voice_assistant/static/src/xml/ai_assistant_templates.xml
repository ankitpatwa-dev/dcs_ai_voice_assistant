<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===================================================== systray -->
    <t t-name="dcs_ai_voice_assistant.SystrayButton">
        <div class="dropdown o_dcs_ai_systray">
            <button class="user-select-none dropdown-toggle o-no-caret o-dropdown--narrow" role="button"
                    title="AI Assistant" aria-label="AI Assistant" t-on-click="this.onClick">
                <i class="oi o_dcs_ai_systray_icon" data-icon="mic" t-att-class="{'o_dcs_ai_systray_live': this.listening}"/>
            </button>
        </div>
    </t>

    <!-- ===================================================== floating widget -->
    <t t-name="dcs_ai_voice_assistant.FloatingAssistant">
        <div class="o_dcs_ai_floating">
            <button t-if="this.showLauncher" class="o_dcs_ai_fab" title="AI Assistant" aria-label="Open AI Assistant"
                    t-on-click="this.open">
                <i class="oi" data-icon="mic"/>
            </button>
            <div t-if="this.state.open" class="o_dcs_ai_popup" role="dialog" aria-label="AI Assistant">
                <AiChatWindow mode="'floating'" onClose.bind="this.close"/>
            </div>
        </div>
    </t>

    <!-- ===================================================== full page -->
    <t t-name="dcs_ai_voice_assistant.AssistantPage">
        <div class="o_action o_dcs_ai_page">
            <div class="o_dcs_ai_page_inner">
                <AiChatWindow mode="'page'"/>
            </div>
        </div>
    </t>

    <!-- ===================================================== microphone -->
    <t t-name="dcs_ai_voice_assistant.Microphone">
        <button type="button" t-att-title="this.title" t-att-aria-label="this.title"
                t-att-disabled="this.state.phase === 'transcribing' or (this.state.busy and !this.listening)"
                t-attf-class="o_dcs_ai_mic {{ this.listening ? 'o_dcs_ai_mic_listening' : '' }} {{ this.state.phase === 'transcribing' ? 'o_dcs_ai_mic_busy' : '' }} {{ this.props.size === 'lg' ? 'o_dcs_ai_mic_lg' : '' }}"
                t-on-click="this.onClick">
            <span t-if="this.listening" class="o_dcs_ai_mic_ring" t-att-style="this.ringStyle"/>
            <i t-if="this.state.phase === 'transcribing'" class="oi oi-spin" data-icon="autorenew"/>
            <i t-elif="this.listening" class="oi" data-icon="stop"/>
            <i t-else="" class="oi" data-icon="mic"/>
        </button>
    </t>

    <!-- ===================================================== chat window -->
    <t t-name="dcs_ai_voice_assistant.ChatWindow">
        <div t-attf-class="o_dcs_ai_chat o_dcs_ai_chat_{{ this.mode }}">
            <header class="o_dcs_ai_header">
                <div t-attf-class="o_dcs_ai_avatar o_dcs_ai_phase_{{ this.state.phase }}">
                    <i class="oi" data-icon="wand_stars"/>
                </div>
                <div class="o_dcs_ai_title">
                    <div class="o_dcs_ai_title_main">AI Assistant</div>
                    <div class="o_dcs_ai_subtitle" t-out="this.statusText"/>
                </div>
                <div class="o_dcs_ai_header_actions">
                    <button t-if="this.state.config.voice_enabled" class="btn btn-sm o_dcs_ai_icon_btn"
                            t-att-class="{'active': this.state.speakerOn}" t-on-click="this.toggleSpeaker"
                            t-att-title="this.state.speakerOn ? 'Stop reading answers aloud' : 'Read every answer aloud'">
                        <i class="oi" t-att-data-icon="this.state.speakerOn ? 'volume_up' : 'volume_off'"/>
                    </button>
                    <button class="btn btn-sm o_dcs_ai_icon_btn" title="Clear conversation" t-on-click="this.clear"
                            t-att-disabled="this.state.busy or !this.state.messages.length">
                        <i class="oi" data-icon="ink_eraser"/>
                    </button>
                    <t t-if="this.mode === 'floating'">
                        <button class="btn btn-sm o_dcs_ai_icon_btn" title="Open full screen" t-on-click="() => this.ai.openFullPage()">
                            <i class="oi" data-icon="expand_content"/>
                        </button>
                        <button class="btn btn-sm o_dcs_ai_icon_btn" title="Close" t-on-click="this.close">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </t>
                </div>
            </header>

            <div t-if="this.state.ready and !this.state.config.configured" class="alert alert-warning m-2 mb-0 py-2 small">
                The AI provider is not configured yet. An administrator can add the API key in
                <strong>Settings › General Settings › AI Voice Assistant</strong>.
            </div>

            <div t-if="!this.state.ready" class="o_dcs_ai_loading">
                <i class="oi oi-spin me-2" data-icon="autorenew"/> Loading…
            </div>
            <AiMessageList t-else="" suggestions="this.suggestions"/>

            <div t-if="this.state.phase === 'listening'" class="o_dcs_ai_live_bar o_dcs_ai_live_listening">
                <span class="o_dcs_ai_wave"><i/><i/><i/><i/><i/></span>
                <span class="o_dcs_ai_live_text" t-out="this.state.interim or 'Listening… speak now'"/>
                <button class="btn btn-sm btn-link" t-on-click="() => this.ai.cancelListening()">Cancel</button>
            </div>
            <div t-elif="this.state.phase === 'speaking'" class="o_dcs_ai_live_bar o_dcs_ai_live_speaking">
                <span t-attf-class="o_dcs_ai_wave {{ this.state.audioPaused ? 'o_dcs_ai_wave_paused' : '' }}"><i/><i/><i/><i/><i/></span>
                <span class="o_dcs_ai_live_text">Speaking</span>
                <button class="btn btn-sm o_dcs_ai_icon_btn" t-att-title="this.state.audioPaused ? 'Resume' : 'Pause'"
                        t-on-click="() => this.ai.togglePause()">
                    <i class="oi" t-att-data-icon="this.state.audioPaused ? 'play_arrow' : 'pause'"/>
                </button>
                <button class="btn btn-sm o_dcs_ai_icon_btn" title="Stop" t-on-click="() => this.ai.stopSpeaking()">
                    <i class="oi" data-icon="stop"/>
                </button>
            </div>

            <footer class="o_dcs_ai_composer">
                <textarea t-ref="this.input" rows="1" class="o_dcs_ai_input" t-att-placeholder="this.placeholder"
                          t-att-disabled="this.state.config.text_enabled === false"
                          t-att-value="this.state.draft" t-on-input="this.onInput" t-on-keydown="this.onKeydown"/>
                <AiMicrophone t-if="this.state.config.voice_enabled" size="this.mode === 'page' ? 'lg' : 'md'"/>
                <button class="o_dcs_ai_send" title="Send" t-att-disabled="!this.canSend" t-on-click="this.submit">
                    <i class="oi" data-icon="send"/>
                </button>
            </footer>
        </div>
    </t>

    <!-- ===================================================== messages -->
    <t t-name="dcs_ai_voice_assistant.MessageList">
        <div class="o_dcs_ai_messages" t-ref="this.root">
            <div t-if="!this.state.messages.length" class="o_dcs_ai_welcome">
                <div class="o_dcs_ai_welcome_icon"><i class="oi" data-icon="wand_stars"/></div>
                <h4>Hi <t t-out="this.state.user.name"/>, how can I help?</h4>
                <p class="text-muted">Ask about sales, CRM, stock or accounting, or tell me what to create or update.
                    Click the microphone to speak. I always ask before changing anything.</p>
                <div class="o_dcs_ai_suggestions">
                    <button t-foreach="this.props.suggestions or []" t-as="s" t-key="s_index" class="o_dcs_ai_chip"
                            t-out="s" t-on-click="() => this.useSuggestion(s)"/>
                </div>
            </div>

            <t t-foreach="this.state.messages" t-as="message" t-key="message.id">
                <div t-attf-class="o_dcs_ai_msg o_dcs_ai_msg_{{ message.role }} {{ message.is_error ? 'o_dcs_ai_msg_error' : '' }} {{ message.pending ? 'o_dcs_ai_msg_pending' : '' }}">
                    <div class="o_dcs_ai_bubble">
                        <div t-if="message.content" class="o_dcs_ai_text" t-out="this.renderText(message.content)"/>
                        <t t-foreach="message.display or []" t-as="block" t-key="block_index">
                            <AiActionCard t-if="block.type === 'action_result'" action="block.action" compact="true"/>
                            <AiDisplayBlock t-else="" block="block"/>
                        </t>
                        <t t-foreach="message.actions or []" t-as="action" t-key="action.id">
                            <AiActionCard action="action"/>
                        </t>
                    </div>
                    <div class="o_dcs_ai_meta">
                        <i t-if="message.input_mode === 'voice'" class="oi" data-icon="mic" title="Spoken"/>
                        <button t-if="message.role === 'assistant' and message.content and this.state.config.voice_enabled"
                                class="btn btn-link btn-sm p-0 o_dcs_ai_speak_btn"
                                t-att-title="this.isSpeaking(message) ? 'Stop' : 'Read aloud'" t-on-click="() => this.toggleSpeak(message)">
                            <i class="oi" t-att-data-icon="this.isSpeaking(message) ? 'stop_circle' : 'volume_up'"/>
                        </button>
                    </div>
                </div>
            </t>

            <div t-if="this.state.busy" class="o_dcs_ai_msg o_dcs_ai_msg_assistant">
                <div class="o_dcs_ai_bubble o_dcs_ai_typing">
                    <span class="o_dcs_ai_dots"><i/><i/><i/></span>
                    <span class="text-muted small ms-2" t-out="this.phaseLabel"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ===================================================== data blocks -->
    <t t-name="dcs_ai_voice_assistant.Table">
        <div class="table-responsive">
            <table class="table table-sm table-hover o_dcs_ai_table mb-0">
                <thead>
                    <tr>
                        <th t-foreach="table.columns" t-as="col" t-key="col.key" t-out="col.label"
                            t-att-class="this.isNumeric(col) ? 'text-end' : ''"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="tableRows" t-as="row" t-key="row_index"
                        t-att-class="this.isClickable(row, table.model) ? 'o_dcs_ai_clickable' : ''"
                        t-att-title="this.isClickable(row, table.model) ? 'Open in Odoo' : ''"
                        t-on-click="() => this.open(row, table.model)">
                        <td t-foreach="table.columns" t-as="col" t-key="col.key" t-out="row.cells[col.key]"
                            t-att-class="this.isNumeric(col) ? 'text-end text-nowrap' : ''"/>
                    </tr>
                    <tr t-if="!tableRows.length"><td t-att-colspan="table.columns.length" class="text-muted">No records found.</td></tr>
                </tbody>
            </table>
        </div>
    </t>

    <t t-name="dcs_ai_voice_assistant.DisplayBlock">
        <t t-set="block" t-value="this.props.block"/>
        <div t-if="block.type === 'table'" class="o_dcs_ai_block">
            <div class="o_dcs_ai_block_title">
                <span t-out="block.title"/>
                <span class="o_dcs_ai_count" t-if="block.total !== undefined">
                    <t t-out="block.rows.length"/><t t-if="block.total > block.rows.length"> of <t t-out="block.total"/></t>
                </span>
            </div>
            <t t-call="dcs_ai_voice_assistant.Table" table="block" tableRows="this.visibleRows"/>
            <button t-if="block.rows.length > 8" class="btn btn-link btn-sm px-0" t-on-click="this.toggleExpanded"
                    t-out="this.local.expanded ? 'Show less' : 'Show all ' + block.rows.length + ' rows'"/>
        </div>

        <div t-elif="block.type === 'record'" class="o_dcs_ai_block o_dcs_ai_record">
            <div class="o_dcs_ai_block_title">
                <span t-out="block.title"/>
                <button class="btn btn-sm btn-link p-0" t-on-click="() => this.ai.openRecord(block.model, block.id)">
                    Open <i class="oi" data-icon="open_in_new"/>
                </button>
            </div>
            <dl class="o_dcs_ai_fields">
                <t t-foreach="block.fields" t-as="f" t-key="f_index">
                    <dt t-out="f.label"/><dd t-out="f.value"/>
                </t>
            </dl>
            <t t-if="block.lines and block.lines.rows.length"
               t-call="dcs_ai_voice_assistant.Table" table="block.lines" tableRows="block.lines.rows"/>
        </div>

        <div t-elif="block.type === 'summary'" class="o_dcs_ai_block o_dcs_ai_summary">
            <div class="o_dcs_ai_block_title"><span t-out="block.title"/></div>
            <div class="o_dcs_ai_stats">
                <div t-foreach="block.stats" t-as="s" t-key="s_index" class="o_dcs_ai_stat">
                    <div class="o_dcs_ai_stat_value" t-out="s.value"/>
                    <div class="o_dcs_ai_stat_label" t-out="s.label"/>
                </div>
            </div>
            <t t-foreach="block.tables or []" t-as="tbl" t-key="tbl_index">
                <div class="o_dcs_ai_subtitle_sm" t-out="tbl.title"/>
                <t t-call="dcs_ai_voice_assistant.Table" table="tbl" tableRows="this.rowsOf(tbl)"/>
                <button t-if="tbl.rows.length > 8" class="btn btn-link btn-sm px-0" t-on-click="this.toggleExpanded"
                        t-out="this.local.expanded ? 'Show less' : 'Show all ' + tbl.rows.length + ' rows'"/>
            </t>
        </div>
    </t>

    <!-- ===================================================== proposals -->
    <t t-name="dcs_ai_voice_assistant.ActionCard">
        <t t-set="a" t-value="this.props.action"/>
        <div t-if="this.props.compact" t-attf-class="o_dcs_ai_action_line o_dcs_ai_action_{{ a.state }}">
            <span t-attf-class="badge rounded-pill {{ this.stateClass }}" t-out="this.stateLabel"/>
            <button t-if="a.state === 'done' and a.res_id and a.model" class="btn btn-link btn-sm p-0" t-on-click="this.openRecord">
                <i class="oi me-1" data-icon="open_in_new"/>Open <t t-out="a.record_name or 'record'"/>
            </button>
            <span t-elif="a.state === 'failed'" class="o_dcs_ai_error_text m-0">Nothing was saved.</span>
        </div>
        <div t-else="" t-attf-class="o_dcs_ai_action o_dcs_ai_action_{{ a.state }}">
            <div class="o_dcs_ai_action_head">
                <i class="oi" t-att-data-icon="a.operation === 'create' ? 'add_circle' : 'edit_square'"/>
                <strong class="flex-grow-1" t-out="a.summary"/>
                <span t-attf-class="badge rounded-pill {{ this.stateClass }}" t-out="this.stateLabel"/>
            </div>
            <ul t-if="a.preview.length" class="o_dcs_ai_preview">
                <li t-foreach="a.preview" t-as="p" t-key="p_index">
                    <span class="o_dcs_ai_preview_label" t-out="p.label"/>
                    <span class="o_dcs_ai_preview_value">
                        <t t-if="p.old !== undefined and p.old !== p.value">
                            <del class="text-muted" t-out="p.old or '—'"/> <i class="oi mx-1 text-muted" data-icon="east"/>
                        </t>
                        <t t-out="p.value or '—'"/>
                    </span>
                </li>
            </ul>
            <t t-if="a.state === 'pending'">
                <div t-foreach="a.warnings" t-as="w" t-key="w_index" class="o_dcs_ai_warning">
                    <i class="oi me-1" data-icon="warning"/><t t-out="w"/>
                </div>
            </t>
            <div t-if="a.state === 'failed' and a.error" class="o_dcs_ai_error_text" t-out="a.error"/>
            <div t-if="a.state === 'pending'" class="o_dcs_ai_action_buttons">
                <button class="btn btn-primary btn-sm" t-att-disabled="this.ai.state.busy" t-on-click="this.confirm">
                    <i class="oi me-1" data-icon="check"/>Confirm
                </button>
                <button class="btn btn-secondary btn-sm" t-att-disabled="this.ai.state.busy" t-on-click="this.cancel">Cancel</button>
                <span class="text-muted small ms-1">or say “yes” / “no”</span>
            </div>
            <div t-if="a.state === 'done' and a.res_id and a.model" class="mt-1">
                <button class="btn btn-link btn-sm p-0" t-on-click="this.openRecord">
                    <i class="oi me-1" data-icon="open_in_new"/>Open <t t-out="a.record_name or 'record'"/>
                </button>
            </div>
        </div>
    </t>

</templates>
